{$LINE 1 'basic.dpps'}
unit Basic;

interface

type
  TSize   {$LINE 8} = (Small, Medium, Large);   {$LINE 6}
  TSizeHelper = record helper for TSize   {$LINE 6}
    function ToString: string;   {$LINE 6}
  end;   {$LINE 8}

  TPlain = (One, Two);

  TSuit   {$LINE 13} = (Hearts = 1, Spades = 4);   {$LINE 11}
  TSuitHelper = record helper for TSuit   {$LINE 11}
    function ToString: string;   {$LINE 11}
  end;   {$LINE 13}

function Describe(S: TSize): string;

implementation

uses
  System.SysUtils;   {$LINE 6}
   {$LINE 6}
function TSizeHelper.ToString: string;   {$LINE 6}
begin   {$LINE 6}
  case Self of   {$LINE 6}
    TSize.Small:  Result := 'Small';   {$LINE 6}
    TSize.Medium: Result := 'Medium';   {$LINE 6}
    TSize.Large:  Result := 'Large';   {$LINE 6}
  else   {$LINE 6}
    Result := '';   {$LINE 6}
  end;   {$LINE 6}
end;   {$LINE 11}
   {$LINE 11}
function TSuitHelper.ToString: string;   {$LINE 11}
begin   {$LINE 11}
  case Self of   {$LINE 11}
    TSuit.Hearts: Result := 'Hearts';   {$LINE 11}
    TSuit.Spades: Result := 'Spades';   {$LINE 11}
  else   {$LINE 11}
    Result := '';   {$LINE 11}
  end;   {$LINE 11}
end;   {$LINE 20}

type
  TLocal   {$LINE 24} = (Near, Far);   {$LINE 22}
  TLocalHelper = record helper for TLocal   {$LINE 22}
    function ToString: string;   {$LINE 22}
  end;   {$LINE 22}
   {$LINE 22}
function TLocalHelper.ToString: string;   {$LINE 22}
begin   {$LINE 22}
  case Self of   {$LINE 22}
    TLocal.Near: Result := 'Near';   {$LINE 22}
    TLocal.Far:  Result := 'Far';   {$LINE 22}
  else   {$LINE 22}
    Result := '';   {$LINE 22}
  end;   {$LINE 22}
end;   {$LINE 24}

function Describe(S: TSize): string;
begin
  Result := S.ToString + ' ' + TSuit.Spades.ToString + ' ' + TLocal.Far.ToString;
end;

end.
