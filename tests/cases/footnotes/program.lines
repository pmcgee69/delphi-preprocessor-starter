{$LINE 2 'program.dpps'}program Footnoted;

{$APPTYPE CONSOLE}

type
  /// <summary>A digit.</summary>
  {$LINE 7}TCount = 0..9;

/// <summary>N squared.</summary>
/// <param name="N">a digit.</param>
/// <returns>from 0 to 81.</returns>
{$LINE 9}function Square(N: TCount): Integer;
begin
  Result := N * N;
end;

begin
  Writeln(Square(3));
end.
{$LINE 22}