{$LINE 1 'basic.dpps'}
program AutoPropertyBasic;

{$APPTYPE CONSOLE}

uses
  System.SysUtils;

type
  TPerson = class
  private   {$LINE 10}
    FName: string;   {$LINE 10}
    FAge: Integer;   {$LINE 10}
  {$LINE 10}
  public
    property Name: string read FName write FName;
    property Age: Integer read FAge write FAge;
    procedure Show;
  protected
    FNotes: string;
    property Notes: string read FNotes write FNotes;   // has read and write: left alone
  end;

procedure TPerson.Show;
begin
  Writeln(Name, ', ', Age);
end;

begin
  var P := TPerson.Create;
  P.Name := 'Vincent';
  P.Age  := 2016;
  P.Show;
  P.Free;
end.
