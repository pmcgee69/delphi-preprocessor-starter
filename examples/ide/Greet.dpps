unit Greet.dpps;

{ A .dpps source: Delphi the rules rewrite before dcc sees it. The project's pre-build event
  writes Greet.pas from this file; edit this one, not Greet.pas. }

interface

uses
  System.SysUtils, System.Diagnostics;
uses
  System.StrUtils;

type
  TGreeting = record
    Name  : string;
    Lang  : string;
    Times : Integer;
  end;

function Greeting(const G: TGreeting): string;   // footnotes: its XMLDoc, from the notes after end.

implementation

function Greeting(const G: TGreeting): string;
begin
  Assert(G.Times > 0);            // assert-message: gains its text, file and line

  var Hello: string;
  case G.Lang of                  // case-of: a case on strings, which dcc refuses, as an if chain
    'en': Hello := 'Hello';
    'fr': Hello := 'Bonjour';
    'de': Hello := 'Hallo';
  else
    Hello := 'G''day';
  end;

  Result := DupeString(Format('%s, %s! ', [Hello, G.Name]), G.Times).TrimRight;
end;

end.

[TGreeting] Who to greet, in which language, and how many times.

[Greeting] A greeting for G, repeated G.Times times on one line.
  G: the name, the language ('en', 'fr' or 'de'; any other is G''day), and the count, at least 1.
  Result: the greetings, separated by spaces.



