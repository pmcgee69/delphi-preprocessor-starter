// The rules' tasks: Ctrl+Shift+P, "task: spawn". Each runs delphi\bin\delphipp.exe, which
// delphi\build.cmd builds (the last task here), so no Python is needed.
[
  {
    "label": "Rules: compile and run this file",
    "command": "bin\\delphipp.exe",
    "args": ["--build", "$ZED_FILE", "--run"],
    "cwd": "$ZED_WORKTREE_ROOT\\delphi"
  },
  {
    "label": "Rules: compile and run this file, Win32",
    "command": "bin\\delphipp.exe",
    "args": ["--build", "$ZED_FILE", "--run", "--win32"],
    "cwd": "$ZED_WORKTREE_ROOT\\delphi"
  },
  {
    "label": "Rules: show what they change in this file",
    "command": "bin\\delphipp.exe",
    "args": ["--diff", "$ZED_FILE"],
    "cwd": "$ZED_WORKTREE_ROOT\\delphi"
  },
  {
    "label": "Rules: list them",
    "command": "bin\\delphipp.exe",
    "args": ["--list"],
    "cwd": "$ZED_WORKTREE_ROOT\\delphi"
  },
  {
    // after changing a rule: then "editor: restart language server", for Zed's marks to use it
    "label": "Rules: build them and run the tests",
    "command": ".\\build.cmd",
    "args": ["test"],
    "cwd": "$ZED_WORKTREE_ROOT\\delphi"
  },

  // The Python side's, for writing rules in Python (with the Python server in
  // .zed\settings.json): uncomment these.
  // {
  //   "label": "Rules (Python): compile and run this file",
  //   "command": "python",
  //   "args": ["-m", "delphipp.build", "$ZED_FILE", "--run"],
  //   "cwd": "$ZED_WORKTREE_ROOT/python"
  // },
  // {
  //   "label": "Rules (Python): show what they change in this file",
  //   "command": "python",
  //   "args": ["-m", "delphipp.build", "$ZED_FILE", "--diff"],
  //   "cwd": "$ZED_WORKTREE_ROOT/python"
  // },
  // {
