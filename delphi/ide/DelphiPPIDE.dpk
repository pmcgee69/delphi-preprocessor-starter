package DelphiPPIDE;

{ The rules in the Delphi IDE's editor: see DelphiPP.IDE.pas. Built by build.cmd
  beside it, for the 32-bit IDE (bds.exe in bin) and the 64-bit one (in bin64). }

{$DESCRIPTION 'DelphiPP: the rules in the editor'}
{$DESIGNONLY}
{$IMPLICITBUILD OFF}

requires
  rtl,
  vcl,
  designide;

contains
  DelphiPP.IDE in 'DelphiPP.IDE.pas',
  DelphiPP.Marks in 'DelphiPP.Marks.pas',
  DelphiPP.Engine in '..\DelphiPP.Engine.pas',
  DelphiPP.Hover in '..\DelphiPP.Hover.pas',
  DelphiPP.Rules in '..\DelphiPP.Rules.pas',
  DelphiPP.Rule.WithStatement in '..\DelphiPP.Rule.WithStatement.pas',
  DelphiPP.Rule.AssertMessage in '..\DelphiPP.Rule.AssertMessage.pas',
  DelphiPP.Rule.WithAndTry in '..\DelphiPP.Rule.WithAndTry.pas',
  DelphiPP.Rule.UsesMerge in '..\DelphiPP.Rule.UsesMerge.pas',
  DelphiPP.Rule.CaseOf in '..\DelphiPP.Rule.CaseOf.pas',
  DelphiPP.Rule.AutoProperty in '..\DelphiPP.Rule.AutoProperty.pas',
  DelphiPP.Rule.DoubleQuotes in '..\DelphiPP.Rule.DoubleQuotes.pas',
  DelphiPP.Rule.Footnotes in '..\DelphiPP.Rule.Footnotes.pas',
  DelphiPP.Rule.Derive in '..\DelphiPP.Rule.Derive.pas',
  TreeSitter.Api in '..\TreeSitter4D\delphi\TreeSitter.Api.pas';

end.
